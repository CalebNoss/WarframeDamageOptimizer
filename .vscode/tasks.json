{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "Build with AVX512 & C++20",
            "command": "cl.exe",
            "args": [
                "/O2",
                "/arch:AVX512",
                "/Zi",
                "/EHsc",
                "/std:c++20",
                "/openmp:llvm",
                "${workspaceFolder}/*.cpp",
                "${workspaceFolder}/imgui/*.cpp",
                "/link",
                "/DEBUG",
                "d3d11.lib",
                "/OUT:${workspaceFolder}/main.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ],
    "version": "2.0.0"
}